# Einstellungen fuer den RD-Quicksupport-Build.
# Wird von .github/quicksupport/apply.sh gelesen.

# ID-/Rendezvous-Server (hbbs). Relay wird automatisch ueber den Server ermittelt.
QS_SERVER="rustdesk.h-od.cloud"

# Oeffentlicher Schluessel des Servers (Inhalt von id_ed25519.pub)
QS_KEY="GO7RwJLEIM7Bzdr4GLkxH+DxNNimdQLVRMH5AoH0MYg="

# App-Name (nur Windows). Ein Name ungleich "RustDesk" schaltet die
# Update-Pruefung gegen die offiziellen RustDesk-Releases ab.
QS_APP_NAME="RD-Quicksupport"
